---
// Reverse-chronological index of Maxim experiments.
// Data comes from the build-time manifest at src/data/experiments.json
// (generated from the pymaxim repo's experiments/README.md lab notebook).
import data from '../data/experiments.json';

// Milestone clusters have a full walkthrough page on this site; everything else
// links out to its entry in the repo.
const MILESTONE = {
	roy: '/research/experiments/roy-harness/',
	substrate: '/research/experiments/substrate-primary-evidence/',
	'cross-session': '/research/experiments/cross-session-learning/',
	cradle: '/research/cradle/',
};

const experiments = [...(data.experiments ?? [])].sort(
	(a, b) =>
		(b.date ?? '').localeCompare(a.date ?? '') ||
		String(b.id).localeCompare(String(a.id)),
);

const newest = experiments.find((e) => e.date)?.date ?? '';
const latest = experiments.slice(0, 3);
const rest = experiments.slice(3);

// Status values that mean "don't read this as a current finding".
const STALE = new Set(['superseded', 'invalidated', 'archived']);

const rows = experiments.map((e) => ({
	...e,
	href: MILESTONE[e.cluster] ?? e.repo_href,
	local: Boolean(MILESTONE[e.cluster]),
	stale: STALE.has(e.status),
	inLatest: latest.includes(e),
}));
---

<div class="exp-index" data-newest={newest}>
	<p class="exp-count">
		{experiments.length} experiments · newest first · raw data and reproduction live in the
		<a href="https://github.com/dennys246/Maxim/tree/main/docs/experiments" rel="noopener"
			>pymaxim repo</a
		>.
	</p>

	<ul class="exp-list">
		{
			rows
				.filter((e) => e.inLatest)
				.map((e) => (
					<li class="exp-row" data-date={e.date ?? ''}>
						<div class="exp-head">
							<span class="exp-title">
								<a href={e.href} rel={e.local ? null : 'noopener'}>
									{e.title}
								</a>
							</span>
							<span class={`exp-status exp-status--${e.status}`}>{e.status}</span>
						</div>
						<div class="exp-meta">
							<span class="exp-id">{e.id}</span>
							{e.date && <span class="exp-date">{e.date}</span>}
							{e.local && <span class="exp-badge">walkthrough</span>}
						</div>
						{e.finding && <p class={e.stale ? 'exp-finding exp-finding--stale' : 'exp-finding'}>{e.finding}</p>}
					</li>
				))
		}
	</ul>

	{
		rest.length > 0 && (
			<details class="exp-more">
				<summary>Show all {experiments.length} experiments</summary>
				<ul class="exp-list">
					{rows
						.filter((e) => !e.inLatest)
						.map((e) => (
							<li class="exp-row" data-date={e.date ?? ''}>
								<div class="exp-head">
									<span class="exp-title">
										<a href={e.href} rel={e.local ? null : 'noopener'}>
											{e.title}
										</a>
									</span>
									<span class={`exp-status exp-status--${e.status}`}>{e.status}</span>
								</div>
								<div class="exp-meta">
									<span class="exp-id">{e.id}</span>
									{e.date && <span class="exp-date">{e.date}</span>}
									{e.local && <span class="exp-badge">walkthrough</span>}
								</div>
								{e.finding && (
									<p class={e.stale ? 'exp-finding exp-finding--stale' : 'exp-finding'}>
										{e.finding}
									</p>
								)}
							</li>
						))}
				</ul>
			</details>
		)
	}
</div>

<script>
	// Per-visitor "New" badges. Progressive enhancement: with JS off, no badges
	// appear but every experiment is still listed and linkable.
	const KEY = 'maxim:experimentsSeen';
	const root = document.querySelector('.exp-index');
	if (root) {
		const newest = root.getAttribute('data-newest') || '';
		let seen = '';
		try {
			seen = localStorage.getItem(KEY) || '';
		} catch {}
		const commit = () => {
			try {
				if (newest) localStorage.setItem(KEY, newest);
			} catch {}
		};

		let badged = 0;
		if (seen && seen < newest) {
			root.querySelectorAll('.exp-row').forEach((row) => {
				const d = row.getAttribute('data-date') || '';
				if (d && d > seen) {
					const b = document.createElement('span');
					b.className = 'exp-new';
					b.textContent = 'New';
					const titleEl = row.querySelector('.exp-title');
					if (titleEl) titleEl.appendChild(b);
					const details = row.closest('details');
					if (details) details.open = true;
					badged++;
				}
			});
		}

		if (!badged) {
			// Nothing was marked — either a first-ever visitor (everything would be
			// new, so badging all of it is noise) or nothing has shipped since the
			// last visit. Record the watermark now; there is nothing to miss.
			commit();
		} else {
			// Only retire the badges once they have actually been on screen for a
			// few seconds. Committing on load meant a single stray page open — or a
			// visit while the badge was mis-rendering — silently burned the markers
			// for good, with no way for the reader to get them back.
			const DWELL_MS = 4000;
			let elapsed = 0;
			let since = document.visibilityState === 'visible' ? Date.now() : 0;
			let done = false;
			const tick = () => {
				if (done) return;
				if (since) elapsed += Date.now() - since;
				if (elapsed >= DWELL_MS) {
					done = true;
					commit();
				}
			};
			const timer = setInterval(() => {
				tick();
				since = document.visibilityState === 'visible' ? Date.now() : 0;
				if (done) clearInterval(timer);
			}, 1000);
			document.addEventListener('visibilitychange', () => {
				tick();
				since = document.visibilityState === 'visible' ? Date.now() : 0;
			});
		}
	}
</script>

<style>
	.exp-count {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.exp-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}
	.exp-row {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
	}
	.exp-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.exp-title {
		font-weight: 600;
	}
	.exp-title a {
		text-decoration: none;
	}
	.exp-meta {
		margin-top: 0.15rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.exp-id {
		font-family: var(--sl-font-mono, monospace);
	}
	.exp-badge {
		color: var(--sl-color-accent-high);
	}
	.exp-finding {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.exp-finding--stale {
		color: var(--sl-color-gray-3);
	}
	.exp-status {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		padding: 0.05em 0.45em;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	.exp-status--recorded {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent-high);
	}
	/* Ran, but deliberately not a settled finding — distinct from both a
	   recorded result and a stale/withdrawn one. */
	.exp-status--partial,
	.exp-status--exploratory,
	.exp-status--pilot,
	.exp-status--in-flight {
		border-color: var(--sl-color-orange, var(--sl-color-gray-4));
		color: var(--sl-color-orange-high, var(--sl-color-gray-2));
	}
	.exp-status--superseded,
	.exp-status--invalidated,
	.exp-status--archived {
		opacity: 0.7;
	}
	/* :global is required, not stylistic. This badge is created by the script
	   below at runtime, so it never receives Astro's scoping class — a scoped
	   rule compiles to `.exp-new:where(.astro-xxxx)` and silently fails to
	   match, leaving an unstyled span butted against the title ("seamNew"). */
	:global(.exp-new) {
		display: inline-block;
		margin-left: 0.5rem;
		padding: 0.05em 0.45em;
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.5;
		border-radius: 999px;
		/* Both tokens invert together per theme, so this one pairing stays legible
		   in both: a dark navy pill with light text in light mode, a light blue
		   pill with dark text in dark mode (13.5:1 and 10.6:1).
		   Note --sl-color-black is #fff in Starlight's LIGHT theme — pairing the
		   plain --sl-color-accent with it silently drops to 3.89:1 in dark mode. */
		background: var(--sl-color-accent-high);
		color: var(--sl-color-black);
		vertical-align: middle;
		white-space: nowrap;
	}
</style>
