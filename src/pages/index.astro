---
const title = 'Maxim';
const tagline =
	'A bio-inspired cognitive architecture for AI agents — embodied sensation, homeostatic drives, and brain-modeled memory that learns across sessions without fine-tuning.';
const description = tagline;
const ogImage = new URL('/og.png', Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} — bio-inspired cognitive architecture for AI agents</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={Astro.site} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.site} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<main>
			<section class="hero">
				<h1>Maxim</h1>
				<p class="tagline">{tagline}</p>
				<div class="install">
					<code id="install-cmd">pip install pymaxim</code>
					<button type="button" data-copy="pip install pymaxim" aria-label="Copy install command" hidden>
						Copy
					</button>
				</div>
				<nav class="links" aria-label="Project links">
					<a href="/getting-started/">Get started</a>
					<a href="https://github.com/dennys246/Maxim" rel="noopener">GitHub</a>
					<a href="https://pypi.org/project/pymaxim/" rel="noopener">PyPI</a>
				</nav>
			</section>

			<section class="what" aria-labelledby="what-heading">
				<h2 id="what-heading">What's in it</h2>
				<ul>
					<li>
						<h3>Embodied sensation</h3>
						<p>
							Agents perceive through a sensory layer instead of raw prompt stuffing — built to
							connect to real hardware like the Reachy robot as well as software environments.
						</p>
					</li>
					<li>
						<h3>Homeostatic drives</h3>
						<p>
							Internal state — energy, curiosity, social need — shifts what the agent attends to
							and chooses to do, the way physiological drives steer behavior.
						</p>
					</li>
					<li>
						<h3>Brain-modeled memory</h3>
						<p>
							Memory systems modeled on their biological counterparts (Hippocampus, NAc, EC, ATL,
							SCN) consolidate experience so an agent learns across sessions — no fine-tuning run
							required.
						</p>
					</li>
				</ul>
			</section>
		</main>
		<footer>
			<p>
				Apache-2.0 · <a href="https://github.com/dennys246/Maxim" rel="noopener">pymaxim</a> ·
				<a href="/getting-started/">Docs</a>
			</p>
		</footer>

		<script>
			// Progressive enhancement: show the copy button only when JS + clipboard exist.
			const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
			if (btn && navigator.clipboard) {
				btn.hidden = false;
				btn.addEventListener('click', async () => {
					await navigator.clipboard.writeText(btn.dataset.copy ?? '');
					btn.textContent = 'Copied';
					setTimeout(() => (btn.textContent = 'Copy'), 1500);
				});
			}
		</script>

		<style>
			:root {
				--bg: #fdfcfa;
				--fg: #1c1b1a;
				--muted: #5c5955;
				--accent: #1a7a63;
				--surface: #f1efeb;
				--border: #dedad4;
				color-scheme: light dark;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #151413;
					--fg: #ecebe8;
					--muted: #a3a09a;
					--accent: #4cc2a4;
					--surface: #201f1d;
					--border: #35332f;
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--fg);
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				line-height: 1.6;
			}
			main {
				max-width: 44rem;
				margin: 0 auto;
				padding: 0 1.25rem;
			}
			.hero {
				padding: 6rem 0 3rem;
				text-align: center;
			}
			h1 {
				font-size: clamp(2.5rem, 8vw, 3.5rem);
				margin: 0 0 1rem;
				letter-spacing: -0.02em;
			}
			.tagline {
				font-size: 1.125rem;
				color: var(--muted);
				max-width: 38rem;
				margin: 0 auto 2rem;
				text-wrap: balance;
			}
			.install {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 0.5rem;
				padding: 0.6rem 1rem;
				margin-bottom: 2rem;
			}
			.install code {
				font-family: ui-monospace, 'SF Mono', Menlo, monospace;
				font-size: 0.95rem;
			}
			.install button {
				font: inherit;
				font-size: 0.8rem;
				color: var(--accent);
				background: none;
				border: 1px solid var(--border);
				border-radius: 0.375rem;
				padding: 0.15rem 0.5rem;
				cursor: pointer;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 1.5rem;
			}
			.links a {
				color: var(--accent);
				font-weight: 500;
				text-decoration: none;
			}
			.links a:hover,
			.links a:focus-visible {
				text-decoration: underline;
			}
			.what {
				padding: 2rem 0 4rem;
				border-top: 1px solid var(--border);
			}
			.what h2 {
				font-size: 1.25rem;
			}
			.what ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1.5rem;
			}
			.what h3 {
				margin: 0 0 0.25rem;
				font-size: 1.05rem;
			}
			.what p {
				margin: 0;
				color: var(--muted);
			}
			footer {
				border-top: 1px solid var(--border);
				text-align: center;
				padding: 1.5rem 1.25rem;
				color: var(--muted);
				font-size: 0.9rem;
			}
			footer a {
				color: var(--accent);
			}
		</style>
	</body>
</html>
